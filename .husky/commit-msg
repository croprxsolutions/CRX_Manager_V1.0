#!/usr/bin/env sh
# The desktop app can point core.hooksPath at another checkout; run this
# worktree's own hook instead. CRX_OWN_HOOK stops a second hand-off.
if [ -z "${CRX_OWN_HOOK:-}" ] && [ -f .husky/commit-msg ] && ! [ "$0" -ef .husky/commit-msg ]; then
  CRX_OWN_HOOK=1 exec sh .husky/commit-msg "$@"
fi

# Commit messages are Git objects too. Reject a renamed/encoded private packet
# before Git creates the commit; diagnostics never print message contents.
node scripts/check-supplier-pricing-phase3-private-artifacts.mjs --commit-msg "${1:-}" || {
  echo ""
  echo "❌ PRIVATE ARTIFACT COMMIT MESSAGE FAILED — remove private packet content from the commit message."
  exit 1
}
