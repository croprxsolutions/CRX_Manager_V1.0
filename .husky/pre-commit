#!/usr/bin/env sh
# The desktop app can point core.hooksPath at another checkout; run this
# worktree's own hook instead (scripts/agent-health-check.mjs pins these lines).
if [ -f .husky/pre-commit ] && { [ "$0" -ef .husky/pre-commit ]; [ $? -eq 1 ]; }; then
  exec sh .husky/pre-commit "$@"
fi

# Keep commits fast and deterministic. This hook checks only staged, high-risk
# surfaces. Full lint, typecheck, unit/guard tests, coverage, and build remain
# durable PR gates in GitHub CI; typecheck and build also run in pre-push when app files change.

if ! STAGED_FILES="$(git diff --cached --no-renames --name-only --diff-filter=ACMRTD)"; then
  echo "❌ Could not read the staged index — commit blocked before safety checks."
  exit 1
fi

# Dependency integrity is relevant only when the dependency contract changed.
# It runs first so a worktree without node_modules stops here, not after every
# other step (scripts/precommit-deps-first.test.mjs).
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(package(-lock)?\.json|\.nvmrc)$'; then
  echo "🔗 Verifying dependency integrity..."
  node scripts/verify-deps.mjs || {
    echo ""
    echo "❌ DEPENDENCY PROBLEMS — run npm ci or fix peer ranges before committing."
    exit 1
  }
fi

echo "📒 Checking ledger requirement..."
node scripts/check-ledger-update.mjs || {
  echo ""
  echo "❌ LEDGER MISSING — stage the real CHANGELOG/decision/reference update for this migration."
  exit 1
}

# Commit time scans only the staged paths (about half a second; Mason, 2026-11-06).
# Pre-push and CI still run the full tracked, untracked and ignored sweep.
echo "🔒 Checking private-artifact containment..."
node scripts/check-supplier-pricing-phase3-private-artifacts.mjs --pre-commit || {
  echo ""
  echo "❌ PRIVATE ARTIFACT CONTAINMENT FAILED — move the artifact outside this repository."
  exit 1
}

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No staged paths — containment passed; skipping staged-file checks."
  exit 0
fi

# Both validators already restrict themselves to staged files and exit quickly
# when their file type is absent.
echo "🛡️ Validating staged SQL migrations..."
bash scripts/validate-sql.sh || exit 1

# A migration can re-define an RPC that the idempotency/contract registries must
# name; these tests failed only in CI on PR #1298. costFields: a column added to a
# per-column-granted table needs its grants (CI-only catch on PR #1437). They read the working tree.
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^supabase/migrations/'; then
  echo "🧾 Checking RPC idempotency and contract registries..."
  if ! git diff --quiet -- supabase/migrations/ src/lib/rpcIdempotencyScope.test.ts src/lib/rpcContracts.test.ts src/lib/costFields.test.ts src/lib/costFields.ts ||
    [ -n "$(git ls-files --others -- supabase/migrations/ src/lib/rpcIdempotencyScope.test.ts src/lib/rpcContracts.test.ts src/lib/costFields.test.ts src/lib/costFields.ts)" ]; then
    echo "❌ Migrations or RPC registry tests have unstaged or untracked edits — stage or remove them so the commit matches what was tested."
    exit 1
  fi
  npx vitest run src/lib/rpcIdempotencyScope.test.ts src/lib/rpcContracts.test.ts src/lib/costFields.test.ts || {
    echo ""
    echo "❌ RPC REGISTRY OR COLUMN-GRANT TESTS FAILED — add the registry entry or column grants this migration needs."
    exit 1
  }
fi

echo "🛡️ Validating staged frontend files..."
bash scripts/validate-frontend.sh || exit 1

# Hook/settings changes can silently become one-sided between Claude and Codex.
# Run the focused manifest/sync check only when that control surface changed.
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(\.agents/|(\.claude|\.codex)/(hooks|commands|skills|workflows|agents)/|\.claude/settings\.json$|\.codex/hooks\.json$|AGENTS\.md$|CLAUDE\.md$|scripts/(agent-health-check|agent-manifest-parity|check-agent-workflows|sync-agent-workflows|normalize-eol)\.mjs$)'; then
  echo "🤝 Checking Claude/Codex workflow and hook parity..."
  node scripts/check-agent-workflows.mjs || {
    echo ""
    echo "❌ AGENT WORKFLOW PARITY FAILED — keep the effective Claude/Codex guard sets aligned."
    exit 1
  }
fi

echo ""
echo "✅ Fast staged-file safety checks passed. Full product proof runs in CI; containment (and typecheck and build when app files change) also run at pre-push."
