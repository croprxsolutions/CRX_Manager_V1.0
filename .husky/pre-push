#!/usr/bin/env sh
# The desktop app can point core.hooksPath at another checkout; run this
# worktree's own hook instead (scripts/agent-health-check.mjs pins these lines).
if [ -f .husky/pre-push ] && { [ "$0" -ef .husky/pre-push ]; [ $? -eq 1 ]; }; then
  exec sh .husky/pre-push "$@"
fi

echo "🛡️ Pre-push safety check..."
echo ""
# git passes the pushed refs on stdin once; keep them for both checks below.
PUSH_REFS="$(cat)"

# Only Taha pushes to Taha's branches (Mason, 2026-11-07; ship.md › Taha's PRs).
if ! printf '%s
' "$PUSH_REFS" | node scripts/check-taha-branch-push.mjs; then
  exit 1
fi

echo "Checking Phase 3C private-artifact containment..."
# Read the real pre-push ref updates from stdin and inspect every outgoing
# commit, including a packet that was committed and later deleted at tip.
if ! node scripts/check-supplier-pricing-phase3-private-artifacts.mjs --pre-push "${1:-}" "${2:-}" 2>&1 <<PUSH_REFS_EOF; then
$PUSH_REFS
PUSH_REFS_EOF
  echo ""
  echo "❌ PRIVATE ARTIFACT CONTAINMENT FAILED — push blocked."
  exit 1
fi

# The workflow map is generated from src/; CI fails a stale one (2026-11-04 retro, PR #1459).
# --check never writes the tracked map.
if [ "$(printf '%s\n' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs --map)" = "check" ]; then
  echo ""
  echo "Checking the workflow map is up to date..."
  # Check the committed inputs, not the working tree, so unsaved edits cannot hide a stale map.
  # Each pushed commit (not HEAD), so pushing another branch checks that branch.
  MAP_SHAS="$(printf '%s\n' "$PUSH_REFS" | awk 'NF >= 2 && $2 !~ /^0+$/ { print $2 }')"
  for MAP_SHA in ${MAP_SHAS:-HEAD}; do
    MAP_DIR="$(mktemp -d)"
    if ! { git archive "$MAP_SHA" src scripts/generate-workflow-map.mjs docs/app-workflow-map.html docs/reference/rpc-functions.md \
        | tar -x -C "$MAP_DIR" && (cd "$MAP_DIR" && node scripts/generate-workflow-map.mjs --check) 2>&1; }; then
      rm -rf "$MAP_DIR"
      echo ""
      echo "❌ WORKFLOW MAP OUT OF DATE — push blocked."
      echo "Run npm run generate-map, commit docs/app-workflow-map.html, then push again."
      exit 1
    fi
    rm -rf "$MAP_DIR"
  done
fi

# A record's SQL sha256 pin taken from a Windows CRLF copy failed 4 CI checks (PR #1579, 2026-11-06 retro).
if [ "$(printf '%s\n' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs --pins)" = "check" ]; then
  echo ""
  echo "Checking migration records' SQL sha256 pins..."
  # Each pushed commit's own files, as for the map check above.
  PIN_SHAS="$(printf '%s\n' "$PUSH_REFS" | awk 'NF >= 2 && $2 !~ /^0+$/ { print $2 }')"
  for PIN_SHA in ${PIN_SHAS:-HEAD}; do
    PIN_DIR="$(mktemp -d)"
    if ! { git archive "$PIN_SHA" supabase/migrations docs/reference/migrations.d docs/reference/migration-history.md \
        | tar -x -C "$PIN_DIR" && node scripts/check-doc-drift.mjs --pins-only "$PIN_DIR" 2>&1; }; then
      rm -rf "$PIN_DIR"
      echo ""
      echo "❌ MIGRATION SQL SHA256 PIN WRONG — push blocked."
      echo "Pin the LF hash git stores: git show HEAD:supabase/migrations/<file>.sql | sha256sum"
      exit 1
    fi
    rm -rf "$PIN_DIR"
  done
fi

# A migration dated today needs CURRENT_STATE and KNOWN_ISSUES stamps that new; CI failed it on PR #1652 (2026-11-08 retro).
if [ "$(printf '%s\n' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs --freshness)" = "check" ]; then
  echo ""
  echo "Checking the live-state docs' Last verified stamps..."
  FRESH_SHAS="$(printf '%s\n' "$PUSH_REFS" | awk 'NF >= 2 && $2 !~ /^0+$/ { print $2 }')"
  for FRESH_SHA in ${FRESH_SHAS:-HEAD}; do
    FRESH_DIR="$(mktemp -d)"
    if ! { git archive "$FRESH_SHA" supabase/migrations docs/manual/CURRENT_STATE.md docs/manual/KNOWN_ISSUES.md \
        | tar -x -C "$FRESH_DIR" && node scripts/check-doc-drift.mjs --freshness-only "$FRESH_DIR" 2>&1; }; then
      rm -rf "$FRESH_DIR"
      echo ""
      echo "❌ LIVE-STATE DOC STAMP STALE — push blocked."
      echo "Re-verify CURRENT_STATE.md and KNOWN_ISSUES.md against the live ledger, then bump their Last verified stamps."
      exit 1
    fi
    rm -rf "$FRESH_DIR"
  done
fi

# A schema registry refresh or an APPLIED LIVE record flip changes which migrations the contract
# tests discover; it failed CI three times despite a written rule (PR #1606, 2026-11-07 retro).
if [ "$(printf '%s
' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs --registry)" = "check" ]; then
  echo ""
  echo "Running the contract tests the schema registry feeds..."
  # Vitest reads the checkout, so each pushed tip must match it on every input these tests read.
  CONTRACT_INPUTS="src supabase/migrations docs/reference .claude/schema-registry.json"
  CONTRACT_SHAS="$(printf '%s\n' "$PUSH_REFS" | awk 'NF >= 2 && $2 !~ /^0+$/ { print $2 }')"
  for CONTRACT_SHA in ${CONTRACT_SHAS:-HEAD}; do
    # shellcheck disable=SC2086
    if ! git diff --quiet "$CONTRACT_SHA" -- $CONTRACT_INPUTS || [ -n "$(git ls-files --others --exclude-standard -- $CONTRACT_INPUTS)" ]; then
      echo ""
      echo "❌ CHECKOUT DIFFERS FROM THE PUSHED COMMIT $CONTRACT_SHA — push blocked."
      echo "The contract tests read this folder. Commit or set aside local changes to $CONTRACT_INPUTS, or push from that branch's checkout."
      exit 1
    fi
  done
  if ! npx vitest run src/lib/rpcContracts.test.ts src/lib/costFields.test.ts 2>&1; then
    echo ""
    echo "❌ CONTRACT TESTS FAILED — push blocked."
    echo "A refresh that passes an applied migration: add its stamp to MIGRATIONS_AWAITING_TYPE_REGENERATION in src/lib/rpcContracts.test.ts."
    exit 1
  fi
fi

# Tests that read an Edge Function's source break when it changes (PR #1515 found out in CI).
EDGE_TESTS="$(printf '%s\n' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs --edge-tests)"
if [ -n "$EDGE_TESTS" ]; then
  echo ""
  echo "Running tests that read the changed Edge Function source..."
  # shellcheck disable=SC2086
  if ! npx vitest run $EDGE_TESTS 2>&1; then
    echo ""
    echo "❌ EDGE FUNCTION SOURCE TESTS FAILED — push blocked."
    echo "Files: $(printf '%s' "$EDGE_TESTS" | tr '\n' ' ')"
    exit 1
  fi
fi

# Type check, code health and build read only app files; CI builds every PR regardless.
if [ "$(printf '%s\n' "$PUSH_REFS" | node scripts/prepush-needs-build.mjs)" = "skip" ]; then
  echo ""
  echo "✅ Phase 3C containment passed; no app files changed, so type check, code health and build are left to CI — pushing to GitHub."
  exit 0
fi

echo "Running TypeScript type check..."
if ! npm run typecheck 2>&1; then
  echo ""
  echo "❌ TYPE CHECK FAILED — push blocked."
  echo "Fix TypeScript errors before pushing to GitHub."
  exit 1
fi

echo ""
echo "Running code-health check..."
# CI fails on unused exports; catching them here saves a re-review (2026-11-03 retro).
if ! npm run check:code-health 2>&1; then
  echo ""
  echo "❌ CODE-HEALTH CHECK FAILED — push blocked."
  echo "Fix the reported unused code before pushing to GitHub."
  exit 1
fi

echo ""
echo "Running build check..."
if ! npm run build 2>&1; then
  echo ""
  echo "❌ BUILD FAILED — push blocked."
  echo "Fix build errors before pushing to GitHub."
  exit 1
fi

# Graphify is not refreshed here: it re-extracted every file on each push and
# rarely changed the map (2026-11-02 retro). Run npm run graph:refresh on demand.

echo ""
echo "✅ Phase 3C containment, type check, code health, and build passed — pushing to GitHub."
