#!/usr/bin/env sh
echo "🛡️ Pre-push safety check..."
echo ""
echo "Checking Phase 3C private-artifact containment..."
# Read the real pre-push ref updates from stdin and inspect every outgoing
# commit, including a packet that was committed and later deleted at tip.
if ! node scripts/check-supplier-pricing-phase3-private-artifacts.mjs --pre-push "${1:-}" "${2:-}" 2>&1; then
  echo ""
  echo "❌ PRIVATE ARTIFACT CONTAINMENT FAILED — push blocked."
  exit 1
fi

echo "Running TypeScript type check..."
if ! npm run typecheck 2>&1; then
  echo ""
  echo "❌ TYPE CHECK FAILED — push blocked."
  echo "Fix TypeScript errors before pushing to GitHub."
  exit 1
fi

echo ""
echo "Running code-health check..."
# CI fails on unused exports; catching them here saves a re-review (2026-11-03 retro).
if ! npm run check:code-health 2>&1; then
  echo ""
  echo "❌ CODE-HEALTH CHECK FAILED — push blocked."
  echo "Fix the reported unused code before pushing to GitHub."
  exit 1
fi

echo ""
echo "Running build check..."
if ! npm run build 2>&1; then
  echo ""
  echo "❌ BUILD FAILED — push blocked."
  echo "Fix build errors before pushing to GitHub."
  exit 1
fi

# Graphify is not refreshed here: it re-extracted every file on each push and
# rarely changed the map (2026-11-02 retro). Run npm run graph:refresh on demand.

echo ""
echo "✅ Phase 3C containment, type check, code health, and build passed — pushing to GitHub."
